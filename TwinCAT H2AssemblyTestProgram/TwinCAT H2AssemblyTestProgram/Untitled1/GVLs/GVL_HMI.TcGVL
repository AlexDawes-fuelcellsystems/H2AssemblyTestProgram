<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_HMI" Id="{6588a7f2-21fd-4376-97e1-41ec9d8aa579}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	//Variables for the dispensing matrix
	aDispManualValveSelection : ARRAY [1..4,1..3] OF BOOL;
	bDispTurnOnMatrix: BOOL;
	bDispResetMatrix:BOOL;
	bDispTurnOnPathing:BOOL;
	bDispActuatePath:BOOL;
	eDispStartOfPath: E_TankBundleNumber;
	eDispEndOfPath:E_OutletNumber;
	aDispStateofValves: ARRAY[1..cMaxRows,1..cMaxCols] OF E_SolenoidState;
	
	//Variables for the inlet matrix
    aInletManualValveSelection : ARRAY [1..2,1..3] OF BOOL;
	bInletTurnOnMatrix: BOOL;
	bInletResetMatrix:BOOL;
	bInbletTurnOnPathing:BOOL;
	bInletActuatePath:BOOL;
	eInletStartOfPath: E_InletToSystem;
	eInletEndOfPath:E_CompressionStages;
	aInletStateofValves: ARRAY[1..cMaxRows,1..cMaxCols] OF E_SolenoidState;
	
	//Variables for the Filling Matrix
	aFillManualValveSelection : ARRAY [1..4,1..3] OF BOOL;
	bFillTurnOnMatrix: BOOL;
	bFillResetMatrix:BOOL;
	bFillTurnOnPathing:BOOL;
	bFillActuatePath:BOOL;
	eFillStartOfPath: E_TankBundleNumber;
	eFillEndOfPath:E_CompressionStages;
	aFillStateofValves: ARRAY[1..cMaxRows,1..cMaxCols] OF E_SolenoidState;
	
END_VAR
VAR_GLOBAL CONSTANT
	cMaxRows:INT:=4;
	cMaxCols:INT:=3;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>