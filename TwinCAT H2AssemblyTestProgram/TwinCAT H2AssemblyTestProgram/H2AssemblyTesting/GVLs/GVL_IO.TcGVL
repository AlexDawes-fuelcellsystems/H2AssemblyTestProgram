  <GVL Name="GVL_IO" Id="{2c457e97-be0a-4e85-8c12-173c6e6c5f49}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	cNumofPT:USINT:=16;
	cNumofMatrices:USINT:=3;
sPTTags : ARRAY[1..cNumofPT] OF T_MaxString := [
        'PT-301-A-II',
        'PT-302-A-II',
        'PT-350-A-II',
        'PT-351-A-II',
        'PT-352-A-II',
        'PT-353-A-II',
        'PT-354-A-II',
        'PT-355-A-II',
        'PT-356-A-II',
        'PT-357-A-II',
        'PT-358-A-II',
        'PT-359-A-II',
        'PT-360-A-II',
        'PT-365-A-II',
        'PT-361-A-II',
        'PT-363-A-II'
    ];
END_VAR
VAR_GLOBAL
	//Sensor Inputs
	aPressRaw AT %I*: ARRAY[1..cNumofPT] OF INT;
    aTempRaw AT %I* : ARRAY[1..cNumofPT]  OF INT;
	
	//Solenoid Outputs
	aInletMAtrixValveCmds AT %Q* : ARRAY [1..GVL_HMI.cInletRows,1..GVL_HMI.cInletCols] OF BOOL;
	aFillMatrixValveCmds AT %Q*: ARRAY [1..GVL_HMI.cMaxRows,1..GVL_HMI.cMaxCols] OF BOOL;
	aDispenseMatrixValveCmds AT %Q*: ARRAY [1..GVL_HMI.cMaxRows,1..GVL_HMI.cMaxCols] OF BOOL;
END_VAR]]></Declaration>
  </GVL>
