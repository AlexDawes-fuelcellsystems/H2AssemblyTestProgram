<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_HMI" Id="{6588a7f2-21fd-4376-97e1-41ec9d8aa579}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	//Variables for the dispensing matrix
	eDispStartOfPath: E_TankBundleNumber;
	eDispEndOfPath:E_OutletNumber;
	//Variables for the inlet matrix
	eInletStartOfPath: E_InletToSystem;
	eInletEndOfPath:E_CompressionStages;
	//Variables for the Filling Matri
	eFillStartOfPath: E_TankBundleNumber;
	eFillEndOfPath:E_CompressionStages;
	//Input Structs for HMI to valve matrices
	stDispHMI:ST_MatrixInputs;
	stInletHMI : ST_MatrixInputs;
    stFillHMI  : ST_MatrixInputs;
	//Variable reset Sensors
	bResetSensors:BOOL;
	//Sensor Error states to display on HMI
	aSensorErrors :  ARRAY[1..GVL_IO.cNumofPT] OF E_ErrorState;
	//Sensor Engineering values
	aPV:  ARRAY[1..GVL_IO.cNumofPT] OF REAL;
	aTV:  ARRAY[1..GVL_IO.cNumofPT] OF REAL;
	//Overall Valve Reset
	bResetAllValves:BOOL;
	
END_VAR
VAR_GLOBAL CONSTANT
	//Set max matrix size at compile time
	cMaxRows:INT:=4;
	cMaxCols:INT:=3;
	cInletRows:INT:=2;
	cInletCols:INT:=3;
    cWarninglevel:LREAL:=500;
    cErrorLevel:LREAL:=525;
    cPressureMinSP:LREAL:=0;
    cPressureMaxSP:LREAL:=1000;
    cTemperatureMinSP:LREAL:=-40;
    cTemperatureMaxSP:LREAL:=125;
    cRawMin:	INT:=0;
    cRawMax:	INT:=32767;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>